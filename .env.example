# Application Configuration
APP_NAME="KiranaAI WhatsApp Retail Platform"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase or SQLite for local dev)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/retail_db
DATABASE_URL="sqlite:///./retail_platform.db"

# Meta WhatsApp Cloud API Configuration
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_waba_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_verify_token"
WHATSAPP_APP_SECRET="your_meta_app_secret_for_sha256_validation"

# AI Order Parsing (Gemini API or Open-source model)
GEMINI_API_KEY="your_google_gemini_api_key"
GEMINI_MODEL_NAME="gemini-1.5-flash"

# Optional Telephony (Exotel - Phase 2)
EXOTEL_SID=""
EXOTEL_TOKEN=""
EXOTEL_SUB_DOMAIN=""
EXOTEL_CALLER_ID=""

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"
